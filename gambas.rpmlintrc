# Those are bogus
addFilter("E: no-dependency-on")
# file info and list are to be filled ad install time
addFilter("E: zero-length")
# the components are modules and not libs
addFilter("W: only-non-binary-in-usr-lib")
# oma crap bug in linting
addFilter("W: not-standard-release-extension")
# I won't write manuals
addFilter("W: no-manual-page-for-binary")
# gbc is needed by script component
addFilter("E: devel-dependency")
# SRPM lint does not see binary-package issues these filters target
addFilter("E: unused-rpmlintrc-filter")
# shared objects live in subpackages named gambas-gb.*, not lib*
addFilter("E: lib-package-without-%mklibname")
